{
	"extends": "$app/tsconfig",
	"include": [
		"src",
		"tests",
		"*"
	],
	"exclude": [
		"src/service-worker"
	],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"types": [
			"$app/types",
			"node"
		]
	}
}
