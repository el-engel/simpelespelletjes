# Kopieer naar .env voor lokaal ontwikkelen. Nooit echte sleutels in de repo zetten.
# Op Netlify zet je dezelfde namen onder Site configuration > Environment variables.

# Supabase (Project Settings > API Keys)
PUBLIC_SUPABASE_URL=https://jouwproject.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudflare Turnstile (dashboard.cloudflare.com > Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Willekeurige lange tekst (minstens 32 tekens) om spel-tokens te ondertekenen
GAME_TOKEN_SECRET=vervang-dit-door-een-lange-willekeurige-tekst

# Alleen lokaal: speel met voorbeeldvragen zonder Supabase
# DEMO_MODE=1

# Contactformulier: mail naar de beheerder via Resend (resend.com, gratis). Optioneel:
# zonder deze twee komen berichten alleen in /beheer > Berichten.
# RESEND_API_KEY=re_...
# CONTACT_EMAIL_TO=jij@voorbeeld.nl
# CONTACT_EMAIL_FROM=Simpele spelletjes <onboarding@resend.dev>
